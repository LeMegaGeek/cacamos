diff --git a/system/sepolicy/private/device_as_webcam.te b/system/sepolicy/private/device_as_webcam.te
index 98c91c2f9a9544e0a458fdf5bda7b4233b3b7c1b..c07a9ae2232fa2256c137374b5d032820baaf784 100644
--- a/system/sepolicy/private/device_as_webcam.te
+++ b/system/sepolicy/private/device_as_webcam.te
@@ -6,7 +6,12 @@ app_domain(device_as_webcam)
 allow device_as_webcam system_app_data_file:dir create_dir_perms;
 allow device_as_webcam system_app_data_file:file create_file_perms;
 
-allow device_as_webcam { app_api_service cameraserver_service }:service_manager find;
+allow device_as_webcam {
+    app_api_service
+    audioserver_service
+    cameraserver_service
+    mediametrics_service
+}:service_manager find;
 
 # Allow DeviceAsWebcam Service needs to access ro.usb.uvc.enabled property to
 # enale/disable itself
@@ -19,3 +24,14 @@ allow device_as_webcam device:dir r_dir_perms;
 # be accessed by the DeviceAsWebcam Service.
 allow device_as_webcam video_device:dir r_dir_perms;
 allow device_as_webcam video_device:chr_file rw_file_perms;
+
+# CaCamOS bridges the Android microphone and speakers to the dedicated UAC2
+# gadget card. No other application domain receives raw ALSA access.
+r_dir_file(device_as_webcam, proc_asound)
+allow device_as_webcam audio_device:dir r_dir_perms;
+allow device_as_webcam audio_device:chr_file rw_file_perms;
+
+# CaCamOS keeps a bounded startup trace in the recovery-readable cache.
+allow device_as_webcam cache_file:dir search;
+allow device_as_webcam cache_recovery_file:dir rw_dir_perms;
+allow device_as_webcam cache_recovery_file:file create_file_perms;
