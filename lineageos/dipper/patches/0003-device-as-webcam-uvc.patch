+    private Size chooseWebcamCaptureSize(int outputWidth, int outputHeight) {
+        Size requestedSize = new Size(outputWidth, outputHeight);
+        if (mCameraId == null) {
+            return requestedSize;
+        }
+
+        StreamConfigurationMap map = getCameraCharacteristic(mCameraId.mainCameraId,
+                CameraCharacteristics.SCALER_STREAM_CONFIGURATION_MAP);
+        if (map == null) {
+            return requestedSize;
+        }
+
+        Size[] outputSizes = map.getOutputSizes(ImageFormat.YUV_420_888);
+        if (outputSizes == null || outputSizes.length == 0) {
+            return requestedSize;
+        }
+
+        long requestedPixels = (long) outputWidth * outputHeight;
+        Size smallestLargerMatch = null;
+        Size largestSmallerMatch = null;
+        Size closestAspectMatch = null;
+        double closestAspectError = Double.MAX_VALUE;
+        long closestPixelDelta = Long.MAX_VALUE;
+        for (Size size : outputSizes) {
+            if (size.equals(requestedSize)) {
+                return requestedSize;
+            }
+
+            long pixels = (long) size.getWidth() * size.getHeight();
+            double aspectError = Math.abs(
+                    ((double) size.getWidth() / size.getHeight())
+                            - ((double) outputWidth / outputHeight));
+            long pixelDelta = Math.abs(pixels - requestedPixels);
+            if (aspectError < closestAspectError
+                    || (aspectError == closestAspectError && pixelDelta < closestPixelDelta)) {
+                closestAspectMatch = size;
+                closestAspectError = aspectError;
+                closestPixelDelta = pixelDelta;
+            }
+
+            if ((long) size.getWidth() * outputHeight
+                    != (long) outputWidth * size.getHeight()) {
+                continue;
+            }
+            if (pixels >= requestedPixels
+                    && (smallestLargerMatch == null
+                    || pixels < (long) smallestLargerMatch.getWidth()
+                    * smallestLargerMatch.getHeight())) {
+                smallestLargerMatch = size;
+            } else if (pixels < requestedPixels
+                    && (largestSmallerMatch == null
+                    || pixels > (long) largestSmallerMatch.getWidth()
+                    * largestSmallerMatch.getHeight())) {
+                largestSmallerMatch = size;
+            }
+        }
+
+        Size captureSize = smallestLargerMatch != null
+                ? smallestLargerMatch
+                : largestSmallerMatch != null ? largestSmallerMatch : closestAspectMatch;
+        if (captureSize == null) {
+            return requestedSize;
+        }
+
+        Log.i(TAG, "Scaling camera capture " + captureSize + " to UVC output "
+                + requestedSize);
+        return captureSize;
+    }
