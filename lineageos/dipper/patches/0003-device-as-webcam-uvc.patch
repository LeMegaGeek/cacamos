+    std::unique_ptr<uint8_t[]> v(new (std::nothrow) uint8_t[chromaBytes]);
+    if (y == nullptr || u == nullptr || v == nullptr) {
+        return false;
+    }
+
+    buffer.y = std::move(y);
+    buffer.u = std::move(u);
+    buffer.v = std::move(v);
+    capacityPixels = pixels;
+    return true;
