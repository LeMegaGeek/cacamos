+/** Minimal recovery-readable startup diagnostics for the CaCamOS appliance. */
+final class BootDiagnostics {
+    private static final String TAG = "CaCamBootDiagnostics";
+    private static final File LOG_FILE =
+            new File("/cache/recovery/cacamos-boot-state.log");
+    private static final long MAX_LOG_BYTES = 256 * 1024;
+
+    private static boolean sInstalled;
+    private static String sBootId;
+
+    private BootDiagnostics() {}
+
+    static void install() {
+        if (!isEnabled()) {
+            return;
+        }
+        synchronized (BootDiagnostics.class) {
+            if (sInstalled) {
+                return;
+            }
+            sInstalled = true;
+            Thread.UncaughtExceptionHandler previous =
+                    Thread.getDefaultUncaughtExceptionHandler();
+            Thread.setDefaultUncaughtExceptionHandler(
+                    (thread, throwable) -> {
+                        recordException(
+                                "uncaught thread=" + thread.getName(), throwable);
+                        if (previous != null) {
+                            previous.uncaughtException(thread, throwable);
+                        } else {
+                            Process.killProcess(Process.myPid());
+                            System.exit(10);
+                        }
+                    });
+        }
+        record("diagnostics-installed");
+    }
+
+    static void record(String state) {
+        if (isEnabled()) {
+            write(state);
+        }
+    }
+
+    static void recordException(String state, Throwable throwable) {
+        if (!isEnabled()) {
+            return;
+        }
+        StringWriter stack = new StringWriter();
+        throwable.printStackTrace(new PrintWriter(stack));
+        write(state + "\n" + stack);
+    }
+
+    private static boolean isEnabled() {
+        return SystemProperties.getBoolean("ro.cacamos.appliance", false);
+    }
+
+    private static synchronized void write(String state) {
+        try {
+            File parent = LOG_FILE.getParentFile();
+            if (parent == null || !parent.isDirectory()) {
+                Log.e(TAG, "Recovery cache directory is unavailable");
+                return;
+            }
+            boolean append = !LOG_FILE.exists() || LOG_FILE.length() < MAX_LOG_BYTES;
+            try (FileWriter writer = new FileWriter(LOG_FILE, append)) {
+                if (!append) {
+                    writer.write("log-rotated\n");
+                }
+                writer.write(
+                        "boot="
+                                + getBootId()
+                                + " uptime_ms="
+                                + SystemClock.elapsedRealtime()
+                                + " pid="
+                                + Process.myPid()
+                                + " thread="
+                                + Thread.currentThread().getName()
+                                + " "
+                                + state
+                                + "\n");
+            }
+        } catch (Exception e) {
+            Log.e(TAG, "Unable to write boot diagnostics", e);
+        }
+    }
+
+    private static String getBootId() {
+        if (sBootId != null) {
+            return sBootId;
+        }
+        try (BufferedReader reader =
+                new BufferedReader(
+                        new FileReader("/proc/sys/kernel/random/boot_id"))) {
+            sBootId = reader.readLine();
+        } catch (Exception e) {
+            sBootId = "unknown";
+        }
+        return sBootId;
+    }
+}
