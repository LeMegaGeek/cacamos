+Status SdkFrameProvider::queueWarmupFrame() {
+    Buffer* producerBuffer = mBufferProducer->getFreeBufferIfAvailable();
+    if (producerBuffer == nullptr) {
+        ALOGE("%s: No buffer available for the warmup frame", __FUNCTION__);
+        return Status::ERROR;
+    }
+
+    producerBuffer->setTimestamp(1);
+    if (mEncoder->encodeWarmupFrame(producerBuffer) != Status::OK) {
+        mBufferProducer->cancelBuffer(producerBuffer);
+        return Status::ERROR;
+    }
+    if (mBufferProducer->queueFilledBuffer(producerBuffer) != Status::OK) {
+        ALOGE("%s: Failed to queue the warmup frame", __FUNCTION__);
+        mBufferProducer->cancelBuffer(producerBuffer);
+        return Status::ERROR;
+    }
+    return Status::OK;
+}
