--- a/system/sepolicy/private/app.te
+++ b/system/sepolicy/private/app.te
@@ -768,8 +768,12 @@ neverallow {
 }:file no_x_file_perms;
 
 # Don't allow apps access to any of the following character devices.
+neverallow {
+    appdomain
