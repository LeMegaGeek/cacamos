diff --git a/device/xiaomi/cmi/device.mk b/device/xiaomi/cmi/device.mk
index c26d284..207c855 100644
--- a/device/xiaomi/cmi/device.mk
+++ b/device/xiaomi/cmi/device.mk
@@ -38,12 +38,24 @@ $(call soong_config_set,xiaomi_kona,variant_lib,//$(LOCAL_PATH):libvariant_xiaom
 # Overlays
 PRODUCT_PACKAGES += \
     ApertureOverlayDevice \
+    CaCamOsDeviceAsWebcamCmi \
     FrameworkResOverlayDevice \
     LineageSettingsOverlayDevice \
     LineageSDKOverlayDevice \
     LineageSystemUIOverlayDevice \
     SystemUIOverlayDevice
 
+# CaCam OS webcam mode
+#
+# Expose the phone as a standard USB Video Class gadget. The actual camera
+# pipeline is Android's privileged DeviceAsWebcam service; hosts see a regular
+# USB webcam instead of a CaCam/BGOBS-specific source.
+PRODUCT_PACKAGES += \
+    DeviceAsWebcam
+
+PRODUCT_VENDOR_PROPERTIES += \
+    ro.usb.uvc.enabled=true
+
 # Permissions
 PRODUCT_COPY_FILES += \
     frameworks/native/data/etc/android.hardware.sensor.barometer.xml:$(TARGET_COPY_OUT_VENDOR)/etc/permissions/android.hardware.sensor.barometer.xml
