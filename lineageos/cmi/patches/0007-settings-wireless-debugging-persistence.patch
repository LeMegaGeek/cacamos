+package com.android.settings.homepage;
+
+import android.content.ComponentName;
+import android.content.Context;
+import android.content.Intent;
+import android.os.SystemProperties;
+import android.text.TextUtils;
+
+import androidx.preference.Preference;
+
+import com.android.settings.core.BasePreferenceController;
+
+/** Returns from maintenance settings to the dedicated CaCamOS webcam UI. */
+public class CaCamOsWebcamPreferenceController extends BasePreferenceController {
+    static final String CACAMOS_APPLIANCE_PROPERTY = "ro.cacamos.appliance";
+    static final ComponentName WEBCAM_COMPONENT = new ComponentName(
+            "com.android.DeviceAsWebcam",
+            "com.android.deviceaswebcam.DeviceAsWebcamPreview");
+
+    public CaCamOsWebcamPreferenceController(Context context, String preferenceKey) {
+        super(context, preferenceKey);
+    }
+
+    @Override
+    public int getAvailabilityStatus() {
+        return SystemProperties.getBoolean(CACAMOS_APPLIANCE_PROPERTY, false)
+                ? AVAILABLE : UNSUPPORTED_ON_DEVICE;
+    }
+
+    @Override
+    public boolean handlePreferenceTreeClick(Preference preference) {
+        if (preference == null
+                || !TextUtils.equals(preference.getKey(), getPreferenceKey())) {
+            return false;
+        }
+
+        Intent intent = new Intent(Intent.ACTION_MAIN)
+                .addCategory(Intent.CATEGORY_HOME)
+                .setComponent(WEBCAM_COMPONENT)
+                .addFlags(Intent.FLAG_ACTIVITY_NEW_TASK
+                        | Intent.FLAG_ACTIVITY_CLEAR_TOP
+                        | Intent.FLAG_ACTIVITY_SINGLE_TOP);
+        mContext.startActivity(intent);
+        return true;
+    }
+}
